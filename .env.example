# Google Sheets API
VITE_GOOGLE_SHEETS_API_KEY=sua_api_key_aqui

# Hotmart API (para sincronizar alunos)
VITE_HOTMART_API_KEY=sua_chave_hotmart_aqui
VITE_HOTMART_AFFILIATE_ID=seu_affiliate_id_aqui

# Google Apps Script Deployment
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_DEPLOYMENT_ID/usercontent
VITE_APPS_SCRIPT_PASSWORD=sua_senha_aqui
